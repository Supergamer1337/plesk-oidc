<?php
/** @var Zend_View_Interface $this */
?>
<?= $this->form instanceof pm_Form_Simple ? $this->form : '' ?>
<span id="identityClaim-help" class="icon-help-muted" tabindex="0">
    <span class="tooltipData">
        This is usually preferred_username. The value must be a valid Plesk login of at most 20 characters.
    </span>
</span>
<script>
    (() => {
        const help = document.getElementById('identityClaim-help');
        document.querySelector('label[for=identityClaim]').after(' ', help);
        Jsw.Tooltip.initData(help);

        const callbackHost = document.getElementById('callbackHost');
        const redirectUri = document.getElementById('redirectUri');
        callbackHost.addEventListener('input', () => {
            redirectUri.value = callbackHost.value.trim() + <?= json_encode(Modules_PleskOidc_Client::CALLBACK_PATH, JSON_HEX_TAG | JSON_THROW_ON_ERROR) ?>;
        });

        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'btn';
        reset.textContent = 'Reset to default';
        reset.addEventListener('click', () => {
            callbackHost.value = <?= json_encode($this->defaultCallbackHost, JSON_HEX_TAG | JSON_THROW_ON_ERROR) ?>;
            callbackHost.dispatchEvent(new Event('input'));
        });
        callbackHost.after(' ', reset);
    })();
</script>
